# ==========================================
# Environment & Secrets (NEVER COMMIT)
# ==========================================
.env
.env.local
.env.*.local
*.env
!.env.example

# ==========================================
# Application Runtime & Data Storage
# ==========================================
backend/storage/*
!backend/storage/.gitkeep
!backend/storage/temp/
backend/storage/temp/*
!backend/storage/temp/.gitkeep
*.db
*.sqlite
*.sqlite3
session_manifest.json
*.log

# ==========================================
# Python & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.python-version
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ==========================================
# Node / Frontend (if applicable)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# IDE & System Files
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

